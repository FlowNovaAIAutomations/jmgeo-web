{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "framework": null,
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/clientes",
      "destination": "https://portal.jmgeo.es",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/_shell.html" }
  ]
}
